# Reactor 网关配置模板——复制为 .env 并填入真实值（.env 已被 gitignore，真实密钥绝不入库）

# 网关监听（单机内网形态）
REACTOR_GATEWAY_HOST=127.0.0.1
REACTOR_GATEWAY_PORT=8787

# M0 开发令牌：各端调用网关的唯一凭证；留空则启动时随机生成并打印
# REACTOR_DEV_TOKEN=

# 模型上游（OpenAI 兼容 /v1；也支持 Anthropic /v1/messages）
REACTOR_UPSTREAM_BASE_URL=https://tokenrhythm.studio/v1
# 必填：上游 API key
REACTOR_UPSTREAM_API_KEY=

# ===== 第 1 批 · Identity（身份底座，测试期）=====
# 监听
REACTOR_IDENTITY_HOST=127.0.0.1
REACTOR_IDENTITY_PORT=8791
# 认证模式：mixed=ad走LDAP/local走本地 | ldap=仅LDAP | local=仅本地测试号
REACTOR_AUTH_MODE=mixed
# 平台身份域 PG（Docker：packages/server/docker compose up -d）
REACTOR_DB_URL=postgres://reactor:reactor@127.0.0.1:55432/reactor
# 测试 mock LDAP（dc=cnpe,dc=cc；真实内网切 sAMAccountName + LDAPS）
REACTOR_LDAP_URL=ldap://127.0.0.1:1389
REACTOR_LDAP_BASE_DN=ou=cnpe,dc=cnpe,dc=cc
REACTOR_LDAP_ADMIN_DN=cn=admin,dc=cnpe,dc=cc
REACTOR_LDAP_ADMIN_PWD=admin123
REACTOR_LDAP_LOGIN_ATTR=uid
# JWT 密钥（测试可留默认，生产必须改）
REACTOR_JWT_SECRET=reactor-dev-jwt-secret-change-me

# ===== 管理台密钥落盘主密钥（T3-4 安全项）=====
# 32 字节（64 位十六进制或 base64）——用于 AES-256-GCM 加密 secrets.field_values 里的敏感字段。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ 留空 = 密钥以明文落库（仅限本地开发）；⚠ 丢失该密钥 = 已加密的密钥无法解密，需重新录入。
REACTOR_SECRET_KEY=

# ===== 软件更新（UPD）=====
# 产物落盘目录：默认 <cwd>/data/updates；容器内由 compose 指定为 /app/data/updates
# REACTOR_UPDATE_FILE_DIR=
# 单个产物上限（字节），默认 1073741824（1GB）；装不下时调大，或改传更小的安装格式
# REACTOR_UPDATE_MAX_BYTES=

# ===== 额度分配（QTM，2026-10-09）=====
# 额度硬阻断开关（网关侧）：默认 false = 只告警不阻断（与历史行为一致）。
# 置 true 后，管理台「用量与额度 → 额度分配」里 action=阻断 的规则超限时网关返回 429。
# 建议：先以 false 跑一个完整周期观察告警，再按组织决定开启。
# REACTOR_QUOTA_ENFORCE=false
# 额度告警外发通道（best-effort webhook，POST JSON；不配置则只落库不推送）
# REACTOR_QUOTA_WEBHOOK_URL=
# 周期时区（预留，方案 P5；当前恒为 UTC，YYYY-MM 口径与既有 quota_alert 数据一致）
# REACTOR_QUOTA_PERIOD_TZ=

# ===== 产品文档入口（DOCS）=====
# 帮助菜单「产品文档」跳转地址。库内（PUT /desktop/policy 的 productDocsUrl）优先，
# 未写库时用这里的值兜底；都不配则端侧提示「尚未配置」不跳转。
# 仅支持 http/https。改完重启服务端生效（写库则立即生效）。
# REACTOR_PRODUCT_DOCS_URL=
