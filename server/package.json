{
  "name": "reactor-server-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Reactor（数智堆脑）服务端独立工作区：身份底座 + 模型网关 + 管理台 API",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:gateway": "pnpm --filter @reactor/server dev",
    "dev:identity": "pnpm --filter @reactor/server dev:identity",
    "docker:up": "docker compose -f packages/server/docker/compose.yml up -d",
    "docker:down": "docker compose -f packages/server/docker/compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
