node_modules/
dist/
# zcode-server-cli 发行包 staging 输出，本地组装产物不入库。
dist-release/
# macOS CI 按架构隔离 electron-builder 输出目录，这些仍是构建产物。
packages/desktop/dist-*/
out/
prebuilds/
bundled-resources/
mock-cdn/
packages/desktop/bundled-resources/
packages/desktop/bundled-agents/
packages/desktop/bundled-tools/
packages/desktop/mock-cdn/
*.tsbuildinfo
.DS_Store
coverage/
.env.local
.env.*.local
.env
.VSCodeCounter
.idea/
.zed/
.cache
# CI 会跨任务保留这些下载缓存；不应进入 Git 未跟踪源码枚举。
/.electron-builder-cache/
/.electron-cache/
/.pnpm-store/
/.npm-cache/
.turbo/
z-work/
openclaw/
.run-logs/
.worktrees/
packages/stream-animate/dist-server/
packages/stream-animate/.stream-animate-data/
.codegraph
.mimosa/
# 集成分支曾混入 node-gyp 构建产物与 .playwright-mcp 临时快照；
# 入库由 scripts/ci/ci-repo-hygiene.mjs 在 CI 第一站拒绝，这里让本地 git add 也忽略它们。
.playwright-mcp/
*.o
.deps/
obj.target/
config.gypi
gyp-mac-tool
*.target.mk
binding.Makefile
# 这两条原来写成 build/Makefile、build/Release/*.node，含中间斜杠的 pattern
# 只相对 .gitignore 所在目录（仓库根）生效，匹配不到 packages/ax-macos/build/ 下的产物；
# 而 ci-repo-hygiene.mjs 的 denylist 用的是 (^|/)build/... 任意层级匹配。
# 宽严不一致时无斜杠 pattern 能拦住的产物会被 git add -A 重新扫进索引。
# 加 **/ 让忽略范围与门禁范围对齐。
**/build/Makefile
**/build/Release/*.node

# CUA 权限浮窗吸附用的 Swift 辅助二进制（由 prepare:macos-window-bounds 从
# packages/desktop/native/macos-window-bounds/main.swift 编出，源码入库、产物不入库）
packages/desktop/resources/macos-window-bounds/
# CUA Helper SEA 基座下载缓存（scripts/cua-helper-sea-base.mjs 落盘的官方 Node 22 运行时，纯下载产物）
/.tmp/
# office-engines 资产下载/解包中间产物（scripts/prepare-office-engines-assets.mjs）；
# 最终 staged 资产在下方已忽略的 packages/desktop/bundled-tools/ 下，此处只是暂存缓存
/.tmp-office-engines/
# Python 字节码（docker/plugin-eval/summarize.py 在主机上跑会生成）。
__pycache__/
*.pyc

# 本地工具运行产物，均可再生：桌面端 e2e 的截图/缓存/网络抓包，以及桌面
# 开发运行器的 Electron 下载缓存。
packages/desktop/.e2e-artifacts/
packages/desktop/.e2e-cache/
packages/desktop/.e2e-network-capture/
.zcode-runtime/

# 本地笔记，内含真实供应商 API Key，只留本地、永不入库。
# 不锚定根目录：文件即使被挪到子目录（或换成同名副本）也仍然被忽略，
# 避免"移动一下就重新暴露给 git add"这种最容易造成永久泄露的路径。
模型信息.txt

# ── 本地垃圾/再生产物（不入库） ─────────────────────────────────
# 一次性实验、调试脚本与输出（*.ps1/*.mjs/*.cs/*.json/*.md 等均按前缀拦）
.tmp-*
# 本地 e2e / 探索脚本
.server-skill-e2e.mts
# zcode 本地工作区与用户配置（与 .gitignore 同内容的副本）
/.zcode/
/.zcodeignore
# 根目录误生成的对照页/预览页
/index.html
# DWG sidecar .NET 构建缓存（源码在 tools/dwg-sidecar/*.cs）
**/dwg-sidecar/bin/
**/dwg-sidecar/obj/
# 产品站点（官网 docs/site/ + 说明书 portal/manual/）构建输出与本地工具
# 说明书源码 pages/*.md 入库；HTML 由 build.mjs 生成，不入库（index.html 除外）
portal/manual/*.html
!portal/manual/index.html
portal/manual/check.mjs
portal/manual/smoke-render.mjs
portal/manual/verify-html.mjs
# 评审用预览截图（临时产物，不进库）
portal/manual/_preview-*.png
# 官网/说明书改版评审截图：playwright 渲染验证输出，同样不入库
portal-preview/

# 审查板块联调用的真实业务数据（含真实项目编号的 PDF/DWG/DOCX/XLSX/PPTX）
# 与提取产物、一次性提取脚本；已在 origin/main 历史中，此处阻止再次纳入索引。
docs/审查板块原始数据/

# 内网部署交付物：Docker 镜像 tar + 数据卷备份 + config/.env（真实生产密钥），
# 总体积约 385MB。属交付物而非源码，严禁入库/外发。
/Reactor 服务端部署镜像/
# tsup 运行期生成的临时展开配置（bundled_<hash>.mjs），非源码
packages/desktop/tsup.config.bundled_*.mjs

# 桌面端安装包本地迭代/交付产物（单文件约 324MB，超过 GitHub 单文件 100MB 硬限制，
# 入库会导致 push 失败）。属交付物而非源码，不入库。
packages/desktop/安装包迭代/

# 第三方逆向分析报告与对照源码：不含本项目代码，且公开仓库不宜外发。
# - 根目录 4 份逆向/可吸收点分析报告（含第三方产品授权机制细节）
# - server/scaffold-master/ 第三方 MIT 脚手架（仅本地对照参考，非本项目产物）
/逆向分析报告-*.md
/Namiwork功能可吸收点-*.md
/NewMax功能可吸收点-*.md
/UI设计吸收点-*.md
server/scaffold-master/

# 构建产物（tsc 生成的声明映射，非源码）
packages/desktop/src/scheduler/*.d.ts.map
# scaffold 对照评估文档：引用未跟踪的参考副本，随该副本一并留在本地
server/SCAFFOLD-*.md
# Excel 导入导出的一次性运行时验证脚本（文件头自述"跑完删除"）
server/packages/server/std-io-verify.mjs
